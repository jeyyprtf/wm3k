# =========================================================================
# WARUNG MADURA 3000 — AI CHATBOT ENVIRONMENT CONFIGURATION
# =========================================================================
# Salin file ini menjadi .env untuk environment backend / bundler kamu.

# Base URL Endpoint OpenAI-Compatible
# Examples:
# OpenAI: https://api.openai.com/v1
# Groq Cloud: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama Local: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API Key milik provider AI kamu
OPENAI_API_KEY=sk-proj-your-api-key-here

# Nama AI Model pilihan
# OpenAI: gpt-4o-mini, gpt-4o
# Groq: llama-3.3-70b-versatile, llama3-8b-8192
# OpenRouter: deepseek/deepseek-chat, anthropic/claude-3.5-haiku
# Ollama Local: llama3.2, mistral
OPENAI_MODEL=gpt-4o-mini

# Parameter Suhu Respon (0.1 - 1.0)
OPENAI_TEMPERATURE=0.7

# Batas Maksimal Token Jawaban
OPENAI_MAX_TOKENS=400
